+              (part) =>
+                (part.progress?.loadedCategories ?? 0) > 0 && part.progress?.status === 'loading',
+            )
+            .map((part) => (
+              <p key={part.kind}>
+                {part.label}: {part.progress?.loadedCategories} de {part.progress?.totalCategories}{' '}
+                categorías cargadas.
+              </p>
+            ))}
+        </div>
+      ) : null}
+      {parts
+        .filter((part) => part.progress?.error && part.progress.status !== 'loading')
+        .map((part) => (
+          <EmptyState
+            key={part.kind}
+            title={
+              part.progress?.status === 'partial'
+                ? `${part.label}: catálogo incompleto`
+                : `No se pudieron cargar ${part.label.toLocaleLowerCase('es')}`
+            }
+            tone="error"
+            actions={
+              <Button icon="refresh" disabled={data?.loading} onClick={reload}>
+                Reintentar carga
+              </Button>
+            }
+          >
+            <p>{part.progress?.error?.message}</p>
+            <p>
+              Código: {part.progress?.error?.code}
+              {part.progress?.error?.detail ? ` · ${part.progress.error.detail}` : ''}
+            </p>
+          </EmptyState>
+        ))}
+      {data?.active ? (
+        <p className="vod__count" aria-live="polite">
+          {plural(data.total)}
+          {data.loading || incomplete ? ' en lo cargado hasta ahora' : ' encontrados'} · Página{' '}
+          {Math.floor(offset / 60) + 1}
+        </p>
+      ) : null}
+      {data?.active && data.items.length ? (
+        <div className="vod__grid" aria-label="Películas y series de tu IPTV">
+          {data.items.map((item: IptvVodItem) => (
+            <Card as="article" key={item.id} padding={0} className="vod-card">
+              <VodArtwork kind={item.kind} title={item.title} posterId={item.posterId} />
+              <div className="vod-card__body">
+                <h2 title={item.title}>{item.title}</h2>
+                <MetadataLine year={item.year} rating={item.rating} genre={item.genre} compact />
+                {item.category ? (
+                  <p className="vod-card__category" title={item.category}>
+                    {item.category}
+                  </p>
+                ) : null}
+                <p className="vod-card__language">
+                  <Icon name="learn" size={16} />
+                  {languageName(item.language ?? preferences.assignments[item.categoryId] ?? null)}
+                </p>
+                {item.kind === 'series' ? (
+                  <Button variant="primary" icon="list" block onClick={() => setSeriesId(item.id)}>
+                    Ver serie y episodios
+                  </Button>
+                ) : (
+                  <div className="vod-card__buttons">
+                    <Button icon="learn" block onClick={() => setMovieId(item.id)}>
+                      Ficha
+                    </Button>
+                    <Button
+                      variant="primary"
+                      icon="play"
+                      block
+                      onClick={() =>
+                        openVideo({ id: item.id, title: item.title, extension: item.extension })
+                      }
+                    >
+                      Reproducir
+                    </Button>
+                  </div>
+                )}
+              </div>
+            </Card>
+          ))}
+        </div>
+      ) : null}
+      {data?.active && !data.loading && !incomplete && data.total === 0 ? (
+        <EmptyState title="No hay resultados" actions={null}>
+          Prueba con otro título, categoría o idioma. Si esperabas contenido, pulsa Actualizar
+          catálogo.
+        </EmptyState>
+      ) : null}
+      {data && !data.active ? (
+        <EmptyState title="Activa tu cuenta Xtream" actions={null}>
+          Configura la cuenta en Ajustes → IPTV para consultar sus películas y series.
+        </EmptyState>
+      ) : null}
+      {data?.active && data.total > 0 ? (
+        <div className="vod__pages">
+          <Button disabled={offset === 0} onClick={() => setOffset(Math.max(0, offset - 60))}>
+            Anterior
+          </Button>
+          <Button
+            disabled={data.nextOffset === null}
+            onClick={() => setOffset(data.nextOffset ?? offset)}
+          >
+            Siguiente
+          </Button>
+        </div>
+      ) : null}
+    </section>
+  );
+}
+
+function MetadataLine({
+  year,
+  rating,
+  genre,
+  compact = false,
+}: {
+  year: string | null;
+  rating: string | null;
+  genre: string | null;
+  compact?: boolean;
+}) {
+  const parts = [year, rating ? `★ ${rating}` : null, genre].filter(Boolean);
+  return parts.length ? (
+    <p className={`vod-card__metadata ${compact ? 'vod-card__metadata--compact' : ''}`}>
+      {parts.join(' · ')}
+    </p>
+  ) : null;
+}
