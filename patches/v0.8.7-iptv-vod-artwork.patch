+    if (this.vodState !== state) throw new AppError('iptv_gone');
+    return {
+      posterId: state.registerImage(id, metadata.posterUrl) ?? movie.posterId,
+      backdropId: state.registerImage(`${id}:backdrop`, metadata.backdropUrl),
+      year: metadata.year ?? movie.year,
+      rating: metadata.rating ?? movie.rating,
+      genre: metadata.genre ?? movie.genre,
+      plot: metadata.plot,
+      director: metadata.director,
+      cast: metadata.cast,
+    };
