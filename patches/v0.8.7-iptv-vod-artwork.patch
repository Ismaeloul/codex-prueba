+  private loadVod(): VodCatalog {
+    this.ensureLoaded();
+    const record = this.record;
+    const secrets = this.secrets;
+    if (!record?.enabled || secrets?.kind !== 'xtream') throw new AppError('iptv_not_configured');
+    if (this.vodState?.providerId === record.id && this.vodState.revision === record.revision)
+      return this.vodState;
+    this.vodState?.dispose();
+    const keys = this.ensureKeys();
+    this.vodState = new VodCatalog(record.id, record.revision, {
+      net: this.deps.net,
+      credentials: secrets,
+      policy: this.policy(),
+      now: () => this.deps.clock.now(),
+      id: (key) => iptvChannelId(keys, record.id, key),
+      redact: (text) => this.redact(text),
+    });
+    return this.vodState;
+  }
