+
+  async image(id: string, reply: FastifyReply, signal: AbortSignal): Promise<void> {
+    this.ensureLoaded();
+    const vodUrl = this.vodState?.imageUrl(id.toLowerCase()) ?? null;
+    const channelUrl = this.catalog?.get(id)?.logoUrl ?? null;
+    const url = vodUrl ?? channelUrl;
+    if (!url || !this.active()) throw new AppError('iptv_gone');
+    const response = await this.deps.net.fetchBuffer(url, {
+      maxBytes: 2 * 1024 * 1024,
+      totalTimeoutMs: 15_000,
+      idleTimeoutMs: 8_000,
+      headers: { 'User-Agent': IPTV_USER_AGENT },
+      accept: 'image/avif,image/webp,image/png,image/jpeg,image/gif,*/*;q=0.3',
+      iptv: this.policy(),
+      signal,
+    });
+    const bytes = response.body;
+    const type = imageMime(bytes);
+    if (!type) throw new AppError('iptv_bad_list');
+    reply
+      .code(200)
+      .header('content-type', type)
+      .header('content-length', String(bytes.length))
+      .header('cache-control', 'private, max-age=3600')
+      .header('x-content-type-options', 'nosniff')
+      .send(bytes);
+  }
+
+  async vodVideo(
+    id: string,
+    reply: FastifyReply,
+    range: string | undefined,
+    signal: AbortSignal,
+  ): Promise<void> {
+    const state = this.loadVod();
+    const secrets = this.secrets;
+    if (secrets?.kind !== 'xtream') throw new AppError('iptv_disabled');
+    const movie = state.byId.get(id.toLowerCase());
+    const episode = state.episodes.get(id.toLowerCase());
+    if ((!movie || movie.kind !== 'peliculas') && !episode) throw new AppError('iptv_gone');
+    const sourceId = episode?.sourceId ?? movie?.sourceId ?? '';
+    const extension = episode?.extension ?? movie?.extension ?? 'mp4';
+    if (extension === 'm3u8') throw new AppError('iptv_unsupported');
+    const url = xtreamVodUrl(secrets, episode ? 'episode' : 'peliculas', sourceId, extension);
+    const headers: Record<string, string> = { 'User-Agent': IPTV_USER_AGENT };
+    const direct = extension === 'mp4' || extension === 'mov' || extension === 'webm';
+    if (direct && range && /^bytes=\d*-\d*$/.test(range)) headers.Range = range;
+    const controller = new AbortController();
+    this.vodStreams.add(controller);
+    const abort = () => controller.abort();
+    signal.addEventListener('abort', abort, { once: true });
+    let opened: Awaited<ReturnType<IptvDeps['net']['openStream']>>;
+    try {
+      opened = await this.deps.net.openStream(url, {
+        idleMs: direct ? 30_000 : 90_000,
+        headers,
+        iptv: this.policy(),
+        signal: controller.signal,
+      });
+    } catch (error) {
+      this.vodStreams.delete(controller);
+      signal.removeEventListener('abort', abort);
+      throw error;
+    }
+    reply.raw.once('close', () => {
+      opened.body.destroy();
+      controller.abort();
+      this.vodStreams.delete(controller);
+      signal.removeEventListener('abort', abort);
+    });
+    if (!direct) {
+      const ffmpeg = spawn(
+        'ffmpeg',
+        [
+          '-hide_banner',
+          '-loglevel',
+          'error',
+          '-i',
+          'pipe:0',
+          '-map',
+          '0:v:0?',
+          '-map',
+          '0:a:0?',
+          '-sn',
+          '-c:v',
+          'copy',
+          '-c:a',
+          'aac',
+          '-f',
+          'mp4',
+          '-movflags',
+          'frag_keyframe+empty_moov+default_base_moof',
+          'pipe:1',
+        ],
+        { stdio: ['pipe', 'pipe', 'pipe'] },
+      );
+      ffmpeg.stderr.resume();
+      ffmpeg.stdin.on('error', () => opened.body.destroy());
+      ffmpeg.on('error', () => opened.body.destroy());
+      opened.body.pipe(ffmpeg.stdin);
+      const close = () => {
+        opened.body.destroy();
+        ffmpeg.kill();
+      };
+      reply.raw.once('close', close);
+      signal.addEventListener('abort', close, { once: true });
+      reply
+        .code(200)
+        .header('content-type', 'video/mp4')
+        .header('cache-control', 'private, no-store');
+      reply.send(ffmpeg.stdout);
+      return;
+    }
+    const mime =
+      extension === 'mp4' || extension === 'mov'
+        ? 'video/mp4'
+        : extension === 'webm'
+          ? 'video/webm'
+          : 'application/octet-stream';
+    reply
+      .code(opened.status)
+      .header('content-type', mime)
+      .header('cache-control', 'private, no-store');
+    for (const name of ['content-length', 'content-range', 'accept-ranges'] as const) {
+      const value = opened.headers[name];
+      if (typeof value === 'string') reply.header(name, value);
+    }
+    reply.send(opened.body);
   }
 
