+  async vodBrowse(query: IptvVodQuery): Promise<IptvVodBrowseResponse> {
+    this.ensureLoaded();
+    const inactive: IptvVodBrowseResponse = {
+      active: false,
+      loading: false,
+      progress: { peliculas: emptyVodProgress(), series: emptyVodProgress() },
+      provider: this.record?.name ?? '',
+      total: 0,
+      movies: 0,
+      series: 0,
+      items: [],
+      categories: [],
+      languages: [],
+      nextOffset: null,
+    };
+    if (!this.record?.enabled || this.secrets?.kind !== 'xtream') return inactive;
+    const state = this.loadVod();
+    state.ensure(query.kind, query.phase, query.categories, query.retry);
+    const items = [...state.byId.values()];
+    const selectedCategories = query.phase === 'items' ? new Set(query.categories) : null;
+    const selectedItems = items.filter(
+      (item) => !selectedCategories || selectedCategories.has(item.categoryId),
+    );
+    const kindItems =
+      query.kind === 'todos'
+        ? selectedItems
+        : selectedItems.filter((item) => item.kind === query.kind);
+    const progress = { peliculas: state.progress('peliculas'), series: state.progress('series') };
+    const loading = (
+      query.kind === 'todos' ? Object.values(progress) : [progress[query.kind]]
+    ).some((part) => part.status === 'loading');
+    const languages = new Set<string>();
+    for (const item of kindItems) if (item.language) languages.add(item.language);
+    const fold = (text: string) =>
+      text
+        .normalize('NFD')
+        .replace(/[\u0300-\u036f]/g, '')
+        .toLowerCase();
+    const needle = fold(query.q.trim());
+    const filtered = kindItems.filter(
+      (item) =>
+        (!query.category || item.categoryId === query.category) &&
+        (!query.language ||
+          (query.language === '__sin-especificar__'
+            ? !item.language
+            : item.language === query.language)) &&
+        (!needle || fold(`${item.title} ${item.category} ${item.language ?? ''}`).includes(needle)),
+    );
+    const page = filtered.slice(query.offset, query.offset + query.limit);
+    return {
+      active: true,
+      loading,
+      progress,
+      provider: this.record.name,
+      total: filtered.length,
+      movies: selectedItems.filter((item) => item.kind === 'peliculas').length,
+      series: selectedItems.filter((item) => item.kind === 'series').length,
+      items: page.map(({ sourceId: _sourceId, ...item }) => item),
+      categories: state.categories(query.kind),
+      languages: [...languages].sort((a, b) => a.localeCompare(b, 'es')),
+      nextOffset: query.offset + page.length < filtered.length ? query.offset + page.length : null,
+    };
+  }
