@@ -0,0 +1,869 @@
+import { useState } from 'react';
+import type { IptvVodItem } from '@ace/shared';
+import { useApiQuery } from '../../api/index.ts';
+import { describeFailure, isApiError } from '../../api/errors.ts';
+import { routeUrl } from '../../api/routes.ts';
+import { useSearchParam } from '../../app/router.tsx';
+import { ViewHeader } from '../../app/ViewHeader.tsx';
+import {
+  Button,
+  Card,
+  EmptyState,
+  Icon,
+  Segmented,
+  SkeletonRows,
+  TextField,
+} from '../../ui/index.ts';
+
+type Kind = 'todos' | 'peliculas' | 'series';
+type Playing = { id: string; title: string; extension: string | null };
+type Language = { id: string; label: string };
+type LanguagePreferences = {
+  applied: boolean;
+  languages: string[];
+  categories: string[];
+  assignments: Record<string, string>;
+};
+
+const PREFS_KEY = 'ace-stream-neo.vod-language-prefs.v1';
+const LANGUAGES: readonly Language[] = [
+  { id: 'es-ES', label: 'Español (España)' },
+  { id: 'es-419', label: 'Español latinoamericano' },
+  { id: 'en', label: 'Inglés' },
+  { id: 'fr', label: 'Francés' },
+  { id: 'de', label: 'Alemán' },
+  { id: 'it', label: 'Italiano' },
+  { id: 'pt-PT', label: 'Portugués (Portugal)' },
+  { id: 'pt-BR', label: 'Portugués (Brasil)' },
+  { id: 'ca', label: 'Catalán' },
+  { id: 'ar', label: 'Árabe' },
+  { id: 'ja', label: 'Japonés' },
+];
+const LANGUAGE_NAMES = new Map(LANGUAGES.map(({ id, label }) => [id, label]));
+const blankPreferences = (): LanguagePreferences => ({
+  applied: false,
+  languages: [],
+  categories: [],
+  assignments: {},
+});
+
+function readPreferences(): LanguagePreferences {
+  if (typeof window === 'undefined') return blankPreferences();
+  try {
+    const raw: unknown = JSON.parse(window.localStorage.getItem(PREFS_KEY) ?? 'null');
+    if (!raw || typeof raw !== 'object') return blankPreferences();
+    const item = raw as Record<string, unknown>;
+    const assignments =
+      item.assignments && typeof item.assignments === 'object'
+        ? Object.fromEntries(
+            Object.entries(item.assignments as Record<string, unknown>).filter(
+              ([key, value]) =>
+                /^[ms]:[A-Za-z0-9_-]{1,80}$/.test(key) &&
+                typeof value === 'string' &&
+                LANGUAGES.some((language) => language.id === value),
+            ),
+          )
+        : {};
+    return {
+      applied: item.applied === true,
+      languages: Array.isArray(item.languages)
+        ? item.languages.filter(
+            (value): value is string =>
+              typeof value === 'string' && LANGUAGES.some((language) => language.id === value),
+          )
+        : [],
+      categories: Array.isArray(item.categories)
+        ? item.categories.filter(
+            (value): value is string =>
+              typeof value === 'string' && /^[ms]:[A-Za-z0-9_-]{1,80}$/.test(value),
+          )
+        : [],
+      assignments: assignments as Record<string, string>,
+    };
+  } catch {
+    return blankPreferences();
+  }
+}
+
+function savePreferences(preferences: LanguagePreferences): void {
+  try {
+    window.localStorage.setItem(PREFS_KEY, JSON.stringify(preferences));
+  } catch {
+    // La selección sigue activa en esta sesión aunque el navegador no permita persistirla.
+  }
+}
+
+function languageName(value: string | null): string {
+  return value ? (LANGUAGE_NAMES.get(value) ?? value) : 'Sin especificar';
+}
+
+const plural = (count: number) => `${count} ${count === 1 ? 'título' : 'títulos'}`;
+const episodeFailure = (error: unknown) =>
+  isApiError(error) && error.code === 'iptv_bad_list'
+    ? 'El proveedor no devolvió una lista de episodios válida.'
+    : describeFailure(error);
+
+function VodArtwork({
+  kind,
+  title,
+  posterId,
+  className = '',
+}: {
+  kind: 'peliculas' | 'series';
+  title: string;
+  posterId: string | null;
+  className?: string;
+}) {
+  const [failedId, setFailedId] = useState<string | null>(null);
+  const [loadedId, setLoadedId] = useState<string | null>(null);
+  const broken = Boolean(posterId && failedId === posterId);
+  const loaded = Boolean(posterId && loadedId === posterId);
+  return (
+    <div
+      className={`vod-card__art ${kind === 'series' ? 'vod-card__art--series' : ''} ${loaded ? 'vod-card__art--loaded' : ''} ${className}`}
+      aria-label={posterId && !broken ? `Carátula de ${title}` : `Imagen genérica de ${title}`}
+    >
+      <span className="vod-card__type">{kind === 'series' ? 'SERIE' : 'PELÍCULA'}</span>
+      <Icon name="cine" size={32} />
+      <span className="vod-card__initial">{title.slice(0, 1).toLocaleUpperCase('es')}</span>
+      {posterId && !broken ? (
+        <img
+          className="vod-card__poster"
+          src={routeUrl('iptvImage', { id: posterId })}
+          alt=""
+          loading="lazy"
+          onLoad={() => setLoadedId(posterId)}
+          onError={() => setFailedId(posterId)}
+        />
+      ) : null}
+    </div>
+  );
+}
+
+function VodBackdrop({ id }: { id: string | null }) {
+  const [failedId, setFailedId] = useState<string | null>(null);
+  if (!id || failedId === id) return null;
+  return (
+    <img
+      className="vod__backdrop"
+      src={routeUrl('iptvImage', { id })}
+      alt=""
+      loading="lazy"
+      onError={() => setFailedId(id)}
+    />
+  );
+}
+
