+  async vodSeries(id: string, signal?: AbortSignal): Promise<IptvVodSeriesResponse> {
+    const state = this.loadVod();
+    const series = state.byId.get(id.toLowerCase());
+    if (!series || series.kind !== 'series') throw new AppError('iptv_gone');
+    const secrets = this.secrets;
+    if (secrets?.kind !== 'xtream') throw new AppError('iptv_disabled');
+    const raw = await xtreamSeriesEpisodes(
+      this.deps.net,
+      secrets,
+      series.sourceId,
+      this.policy(),
+      signal,
+    );
+    if (this.vodState !== state) throw new AppError('iptv_gone');
+    const episodes = raw.episodes.map((episode) => {
+      const episodeId = iptvChannelId(
+        this.ensureKeys(),
+        state.providerId,
+        `vod:episode:${series.sourceId}:${episode.sourceId}`,
+      );
+      state.episodes.set(episodeId, { sourceId: episode.sourceId, extension: episode.extension });
+      return {
+        id: episodeId,
+        title: episode.title,
+        season: episode.season,
+        episode: episode.episode,
+        extension: episode.extension,
+        posterId: state.registerImage(`${episodeId}`, episode.posterUrl),
+      };
+    });
+    return {
+      title: series.title,
+      posterId: state.registerImage(id, raw.metadata.posterUrl),
+      year: raw.metadata.year,
+      rating: raw.metadata.rating,
+      genre: raw.metadata.genre,
+      plot: raw.metadata.plot,
+      director: raw.metadata.director,
+      cast: raw.metadata.cast,
+      backdropId: state.registerImage(`${id}:backdrop`, raw.metadata.backdropUrl),
+      episodes,
+    };
+  }
+
+  async vodMovie(id: string, signal?: AbortSignal): Promise<IptvVodMovieResponse> {
+    const state = this.loadVod();
+    const movie = state.byId.get(id.toLowerCase());
+    if (!movie || movie.kind !== 'peliculas') throw new AppError('iptv_gone');
+    const secrets = this.secrets;
+    if (secrets?.kind !== 'xtream') throw new AppError('iptv_disabled');
+    const metadata = await xtreamMovieInfo(
