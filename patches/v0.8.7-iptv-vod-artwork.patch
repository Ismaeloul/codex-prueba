@@ -0,0 +1,324 @@
+import { errorMessage, type IptvVodItem, type IptvVodProgress } from '@ace/shared';
+import { AppError } from '../../core/errors.js';
+import type { IptvFetchPolicy, NetClient } from '../net/types.js';
+import { toIptvError } from './errors.js';
+import { vodLanguage, xtreamVodCategories, xtreamVodItems, type RawVodItem } from './vod.js';
+import type { XtreamCredentials } from './xtream.js';
+
+type Kind = RawVodItem['kind'];
+export interface VodRecord extends IptvVodItem {
+  readonly sourceId: string;
+}
+interface Part {
+  status: IptvVodProgress['status'];
+  categories: Map<string, string>;
+  categoriesReady: boolean;
+  completed: Set<string>;
+  attempted: Set<string>;
+  errors: Map<string, NonNullable<IptvVodProgress['error']>>;
+  wanted: Set<string>;
+  error: IptvVodProgress['error'];
+  at: number;
+  count: number;
+  retry: string | undefined;
+  controller: AbortController | null;
+}
+const emptyPart = (): Part => ({
+  status: 'idle',
+  categories: new Map(),
+  categoriesReady: false,
+  completed: new Set(),
+  attempted: new Set(),
+  errors: new Map(),
+  wanted: new Set(),
+  error: null,
+  at: 0,
+  count: 0,
+  retry: undefined,
+  controller: null,
+});
+export const emptyVodProgress = (): IptvVodProgress => ({
+  status: 'idle',
+  loadedCategories: 0,
+  totalCategories: 0,
+  error: null,
+});
+
+/**
+ * El listado Xtream se pide solo por categorías seleccionadas. La primera
+ * consulta lee dos listas pequeñas de categorías y nunca descarga el VOD entero.
+ */
+export class VodCatalog {
+  readonly byId = new Map<string, VodRecord>();
+  readonly episodes = new Map<string, { sourceId: string; extension: string }>();
+  private readonly imageUrls = new Map<string, string>();
+  private readonly parts: Record<Kind, Part> = { peliculas: emptyPart(), series: emptyPart() };
+  private disposed = false;
+
+  constructor(
+    readonly providerId: string,
+    readonly revision: number,
+    private readonly deps: {
+      net: NetClient;
+      credentials: XtreamCredentials;
+      policy: IptvFetchPolicy;
+      now: () => number;
+      id: (key: string) => string;
+      redact: (text: string) => string;
+    },
+  ) {}
+
+  dispose(): void {
+    this.disposed = true;
+    for (const part of Object.values(this.parts)) part.controller?.abort();
+    this.byId.clear();
+    this.episodes.clear();
+    this.imageUrls.clear();
+  }
+
+  ensure(
+    kind: 'todos' | Kind,
+    phase: 'categories' | 'items',
+    categories: readonly string[],
+    retry?: string,
+  ): void {
+    for (const selected of kind === 'todos' ? (['peliculas', 'series'] as const) : [kind]) {
+      const part = this.parts[selected];
+      if (this.disposed || part.controller) continue;
+      if (phase === 'categories' || categories.length === 0) {
+        this.startCategories(selected, part, retry);
+        continue;
+      }
+      const prefix = selected === 'peliculas' ? 'm:' : 's:';
+      const wanted = new Set(
+        categories
+          .filter((id) => id.startsWith(prefix))
+          .map((id) => id.slice(2))
+          .filter((id) => part.categories.has(id)),
+      );
+      part.wanted = wanted;
+      if (!part.categoriesReady) {
+        this.startCategories(selected, part, retry);
+        continue;
+      }
+      const retrying = retry !== undefined && retry !== part.retry;
+      if (retrying) {
+        part.retry = retry;
+        for (const id of wanted) {
+          part.attempted.delete(id);
+          part.completed.delete(id);
+          part.errors.delete(id);
+        }
+      }
+      this.startItems(selected, part, wanted);
+    }
+  }
+
+  progress(kind: Kind): IptvVodProgress {
+    const part = this.parts[kind];
+    let loadedCategories = 0;
+    for (const id of part.wanted) if (part.completed.has(id)) loadedCategories++;
+    const error = [...part.wanted].map((id) => part.errors.get(id)).find(Boolean) ?? part.error;
+    return {
+      status: part.status,
+      loadedCategories,
+      totalCategories: part.wanted.size,
+      error,
+    };
+  }
+
+  categories(kind: 'todos' | Kind): {
+    id: string;
+    name: string;
+    count: number;
+    loaded: boolean;
+    language: string | null;
+  }[] {
+    const result = new Map<
+      string,
+      { id: string; name: string; count: number; loaded: boolean; language: string | null }
+    >();
+    for (const selected of kind === 'todos' ? (['peliculas', 'series'] as const) : [kind]) {
+      const part = this.parts[selected];
+      for (const [key, name] of part.categories) {
+        const id = `${selected === 'peliculas' ? 'm' : 's'}:${key}`;
+        result.set(id, {
+          id,
+          name: this.deps.redact(name),
+          count: 0,
+          loaded: part.completed.has(key),
+          language: vodLanguage(name),
+        });
+      }
+    }
+    for (const item of this.byId.values()) {
+      if (kind !== 'todos' && kind !== item.kind) continue;
+      const entry = result.get(item.categoryId);
+      if (entry) entry.count++;
+      else if (item.category)
+        result.set(item.categoryId, {
+          id: item.categoryId,
+          name: item.category,
+          count: 1,
+          loaded: this.parts[item.kind].status === 'ready',
+          language: vodLanguage(item.category, item.language ?? ''),
+        });
+    }
+    return [...result.values()];
+  }
+
+  imageUrl(id: string): string | null {
+    return this.imageUrls.get(id.toLowerCase()) ?? null;
+  }
+
+  /** Registra una URL privada al servidor y devuelve solo su id firmado. */
+  registerImage(owner: string, url: string | null): string | null {
+    if (!url || this.disposed) return null;
+    const id = this.deps.id(`vod:image:${owner}:${url}`);
+    this.imageUrls.set(id, url);
+    return id;
+  }
+
+  private startCategories(kind: Kind, part: Part, retry?: string): void {
+    if (part.categoriesReady || this.disposed || part.controller) return;
+    const retrying = retry !== undefined && retry !== part.retry;
+    if (retrying) {
+      part.retry = retry;
+      part.error = null;
+    }
+    part.status = 'loading';
+    const controller = new AbortController();
+    part.controller = controller;
+    void (async () => {
+      try {
+        part.categories = await xtreamVodCategories(
+          this.deps.net,
+          this.deps.credentials,
+          kind === 'peliculas' ? 'get_vod_categories' : 'get_series_categories',
+          this.deps.policy,
+          controller.signal,
+        );
+        part.categoriesReady = true;
+        part.error = null;
+        part.status = 'idle';
+      } catch (error) {
+        if (!this.disposed) {
+          part.status = 'error';
+          part.error = this.failure(controller.signal.aborted ? controller.signal.reason : error);
+        }
+      } finally {
+        part.controller = null;
+      }
+    })();
+  }
+
+  private startItems(kind: Kind, part: Part, wanted: Set<string>): void {
+    if (this.disposed || part.controller) return;
+    if (!wanted.size) {
+      part.status = 'idle';
+      part.error = null;
+      return;
+    }
+    const pending = [...wanted].filter((id) => !part.attempted.has(id));
+    if (!pending.length) {
+      const failures = pending.length || [...wanted].some((id) => part.errors.has(id));
+      part.status = failures ? (part.count ? 'partial' : 'error') : 'ready';
+      part.error = [...wanted].map((id) => part.errors.get(id)).find(Boolean) ?? null;
+      return;
+    }
+    part.status = 'loading';
+    part.error = [...wanted].map((id) => part.errors.get(id)).find(Boolean) ?? null;
+    const controller = new AbortController();
+    part.controller = controller;
+    void this.loadItems(kind, part, pending, controller);
+  }
+
+  private put(raw: RawVodItem, part: Part): void {
+    if (this.disposed) return;
+    const id = this.deps.id(`vod:${raw.kind}:${raw.sourceId}`);
+    if (!this.byId.has(id) && part.count >= 100_000) throw new AppError('iptv_too_large');
+    const category = this.deps.redact(part.categories.get(raw.categoryId) ?? '');
+    const posterId = this.registerImage(id, raw.posterUrl);
+    if (!this.byId.has(id)) part.count++;
+    this.byId.set(id, {
+      id,
+      kind: raw.kind,
+      title: this.deps.redact(raw.title),
+      category,
+      categoryId: `${raw.kind === 'peliculas' ? 'm' : 's'}:${raw.categoryId}`,
+      language: vodLanguage(raw.language, category),
+      extension: raw.extension,
+      posterId,
+      year: raw.year,
+      rating: raw.rating,
+      genre: raw.genre,
+      sourceId: raw.sourceId,
+    });
+  }
+
+  private async loadItems(
+    kind: Kind,
+    part: Part,
+    categories: readonly string[],
+    controller: AbortController,
+  ): Promise<void> {
+    const timer = setTimeout(() => controller.abort(new AppError('iptv_timeout')), 8 * 60_000);
+    timer.unref();
+    let firstError: unknown = null;
+    try {
+      for (const categoryId of categories) {
+        if (controller.signal.aborted || this.disposed) break;
+        part.attempted.add(categoryId);
+        try {
+          await xtreamVodItems(
+            this.deps.net,
+            this.deps.credentials,
+            kind,
+            this.deps.policy,
+            controller.signal,
+            { categoryId, onItem: (item) => this.put(item, part) },
+          );
+          part.completed.add(categoryId);
+          part.errors.delete(categoryId);
+        } catch (error) {
+          if (controller.signal.aborted) throw controller.signal.reason;
+          const failure = toIptvError(error, 'list');
+          firstError ??= error;
+          part.errors.set(categoryId, this.failure(error));
+          if (failure.code === 'iptv_auth_failed' || failure.code === 'iptv_busy') break;
+          // Un límite en una categoría no debe impedir cargar las demás.
+        }
+      }
+      if (controller.signal.aborted) throw controller.signal.reason;
+      const failed = [...part.wanted].some((id) => part.errors.has(id));
+      part.status = failed ? (part.count ? 'partial' : 'error') : 'ready';
+      part.error = [...part.wanted].map((id) => part.errors.get(id)).find(Boolean) ?? null;
+      if (firstError && !part.error) part.error = this.failure(firstError);
+    } catch (error) {
+      if (!this.disposed) {
+        part.status = part.count ? 'partial' : 'error';
+        part.error = this.failure(controller.signal.aborted ? controller.signal.reason : error);
+      }
+    } finally {
+      clearTimeout(timer);
+      part.at = this.deps.now();
+      part.controller = null;
+    }
+  }
+
+  private failure(error: unknown): NonNullable<IptvVodProgress['error']> {
+    const safe = toIptvError(error, 'list');
+    return {
+      code: safe.code,
+      message:
+        safe.code === 'iptv_bad_list'
+          ? 'El proveedor devolvió una respuesta que no es un catálogo Xtream válido.'
+          : safe.code === 'iptv_busy'
+            ? 'El proveedor ha limitado las consultas. Espera un momento y vuelve a intentarlo.'
+            : safe.code === 'iptv_too_large'
+              ? 'Esta categoría supera el límite seguro de títulos. Elige otra categoría o idioma.'
+              : errorMessage(safe.code),
+      detail: safe.detail && /^[a-zA-Z0-9_:.-]{1,60}$/.test(safe.detail) ? safe.detail : null,
+    };
+  }
+}
