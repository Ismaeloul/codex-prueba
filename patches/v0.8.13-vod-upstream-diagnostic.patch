+
+  it('informa de forma segura del fallo upstream y devuelve 502', async () => {
+    const failure = new Error('http_416');
+    const onUpstreamError = vi.fn();
+    const controller = new AbortController();
+    const proxy = await createVodInputProxy({
+      net: {
+        openStream: vi.fn<NetClient['openStream']>(async () => Promise.reject(failure)),
+      } as unknown as NetClient,
+      upstreamUrl: 'https://proveedor.example/usuario/secreto/42.mp4',
+      headers: { 'User-Agent': 'Ace Player Neo' },
+      iptv: { lan: false },
+      signal: controller.signal,
+      onUpstreamError,
+    });
+    proxies.push(proxy);
+
+    await expect(request(proxy.url, 'bytes=0-')).resolves.toEqual({ status: 502, body: '' });
+    expect(onUpstreamError).toHaveBeenCalledWith(failure, {
+      method: 'GET',
+      range: 'bytes=0-',
+    });
+  });
 });
