diff --git a/ace-player-neo/apps/server/src/modules/iptv/vod.ts b/ace-player-neo/apps/server/src/modules/iptv/vod.ts
--- /dev/null
+++ b/ace-player-neo/apps/server/src/modules/iptv/vod.ts
@@ -0,0 +1,213 @@
+import { IPTV_USER_AGENT, IPTV_XTREAM_LIMITS } from '@ace/shared';
+import { AppError } from '../../core/errors.js';
+import type { IptvFetchPolicy, NetClient } from '../net/types.js';
+import { toIptvError } from './errors.js';
+import { parseJsonArrayStream } from './json-array.js';
+import { streamCategoryId, xtreamApiUrl, type XtreamCredentials } from './xtream.js';
+
+const HEADERS = { 'User-Agent': IPTV_USER_AGENT };
+const MAX_VOD_ITEMS = 100_000;
+const MAX_VOD_BYTES = 96 * 1024 * 1024;
+const MAX_EPISODES = 2_000;
+
+export interface RawVodItem {
+  readonly sourceId: string;
+  readonly kind: 'peliculas' | 'series';
+  readonly title: string;
+  readonly categoryId: string;
+  readonly language: string;
+  readonly extension: string | null;
+}
+
+export interface RawVodEpisode {
+  readonly sourceId: string;
+  readonly title: string;
+  readonly season: number;
+  readonly episode: number;
+  readonly extension: string;
+}
+
+const stringOf = (value: unknown): string => {
+  if (typeof value === 'string') return value.trim();
+  if (typeof value === 'number' && Number.isFinite(value)) return String(value);
+  return '';
+};
+
+const numberOf = (value: unknown): number => {
+  const number = Number(value);
+  return Number.isFinite(number) && number >= 0 ? Math.floor(number) : 0;
+};
+
+export const safeVodExtension = (value: unknown): string => {
+  const extension = stringOf(value).toLowerCase().replace(/^\./, '');
+  return /^(mp4|mkv|avi|mov|m3u8|ts|webm)$/.test(extension) ? extension : 'mp4';
+};
+
+export function vodLanguage(...values: string[]): string | null {
+  const text = values
+    .join(' ')
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .toLowerCase();
+  const patterns: readonly [RegExp, string][] = [
+    [/(?:^|[^a-z])(castellano|espanol|spanish|latino|latam|esp|spa|es)(?:$|[^a-z])/, 'Español'],
+    [/(?:^|[^a-z])(english|ingles|eng|en)(?:$|[^a-z])/, 'Inglés'],
+    [/(?:^|[^a-z])(french|frances|fra|fr)(?:$|[^a-z])/, 'Francés'],
+    [/(?:^|[^a-z])(german|aleman|deutsch|ger|de)(?:$|[^a-z])/, 'Alemán'],
+    [/(?:^|[^a-z])(italian|italiano|ita|it)(?:$|[^a-z])/, 'Italiano'],
+    [/(?:^|[^a-z])(portuguese|portugues|por|pt)(?:$|[^a-z])/, 'Portugués'],
+    [/(?:^|[^a-z])(catalan|catala|cat|ca)(?:$|[^a-z])/, 'Catalán'],
+    [/(?:^|[^a-z])(arabic|arabe|ara)(?:$|[^a-z])/, 'Árabe'],
+    [/(?:^|[^a-z])(japanese|japones|jpn)(?:$|[^a-z])/, 'Japonés'],
+  ];
+  for (const [pattern, label] of patterns) if (pattern.test(text)) return label;
+  return null;
+}
+
+export async function xtreamVodCategories(
+  net: NetClient,
+  credentials: XtreamCredentials,
+  action: 'get_vod_categories' | 'get_series_categories',
+  policy: IptvFetchPolicy,
+  signal?: AbortSignal,
+): Promise<Map<string, string>> {
+  try {
+    const response = await net.fetchJson(xtreamApiUrl(credentials, action), {
+      maxBytes: IPTV_XTREAM_LIMITS.liveCategories.maxBytes,
+      totalTimeoutMs: IPTV_XTREAM_LIMITS.liveCategories.totalMs,
+      idleTimeoutMs: IPTV_XTREAM_LIMITS.liveCategories.totalMs,
+      headers: HEADERS,
+      iptv: policy,
+      ...(signal ? { signal } : {}),
+    });
+    const categories = new Map<string, string>();
+    if (!Array.isArray(response.body)) throw new Error('bad_response');
+    for (const raw of response.body) {
+      if (!raw || typeof raw !== 'object') continue;
+      const item = raw as Record<string, unknown>;
+      const id = stringOf(item.category_id);
+      const name = stringOf(item.category_name);
+      if (id && name) categories.set(id.slice(0, 80), name.slice(0, 200));
+    }
+    return categories;
+  } catch (error) {
+    throw toIptvError(error, 'list');
+  }
+}
+
+export async function xtreamVodItems(
+  net: NetClient,
+  credentials: XtreamCredentials,
+  kind: RawVodItem['kind'],
+  policy: IptvFetchPolicy,
+  signal?: AbortSignal,
+  options: { categoryId?: string; onItem?: (item: RawVodItem) => void } = {},
+): Promise<RawVodItem[]> {
+  const action = kind === 'peliculas' ? 'get_vod_streams' : 'get_series';
+  const items: RawVodItem[] = [];
+  try {
+    const response = await net.openStream(
+      xtreamApiUrl(
+        credentials,
+        action,
+        options.categoryId === undefined ? {} : { category_id: options.categoryId },
+      ),
+      {
+        maxBytes: MAX_VOD_BYTES,
+        totalMs: 120_000,
+        idleMs: 25_000,
+        headersMs: 90_000,
+        headers: HEADERS,
+        accept: 'application/json',
+        iptv: { ...policy, maxDecompressedBytes: MAX_VOD_BYTES * 2 },
+        ...(signal ? { signal } : {}),
+      },
+    );
+    let count = 0;
+    const parsed = await parseJsonArrayStream(
+      response.body,
+      (item) => {
+        const sourceId = stringOf(kind === 'peliculas' ? item.stream_id : item.series_id);
+        const title = stringOf(item.name);
+        if (!/^[A-Za-z0-9_-]{1,40}$/.test(sourceId) || !title) return;
+        if (count++ >= MAX_VOD_ITEMS) throw new AppError('iptv_too_large');
+        const entry: RawVodItem = {
+          sourceId,
+          kind,
+          title: title.slice(0, 240),
+          categoryId: (streamCategoryId(item) || options.categoryId || '').slice(0, 80),
+          language: stringOf(item.language).slice(0, 40),
+          extension: kind === 'peliculas' ? safeVodExtension(item.container_extension) : null,
+        };
+        if (options.onItem) options.onItem(entry);
+        else items.push(entry);
+      },
+      { maxObjectBytes: 64 * 1024, ...(signal ? { signal } : {}) },
+    );
+    // A broken/nonconforming list must not look like a successfully empty catalog.
+    if (parsed.skipped || (parsed.objects > 0 && count === 0)) throw new Error('bad_response');
+  } catch (error) {
+    throw toIptvError(error, 'list');
+  }
+  return items;
+}
+
+export async function xtreamSeriesEpisodes(
+  net: NetClient,
+  credentials: XtreamCredentials,
+  seriesId: string,
+  policy: IptvFetchPolicy,
+  signal?: AbortSignal,
+): Promise<RawVodEpisode[]> {
+  try {
+    const response = await net.fetchJson(
+      xtreamApiUrl(credentials, 'get_series_info', { series_id: seriesId }),
+      {
+        maxBytes: 8 * 1024 * 1024,
+        totalTimeoutMs: 30_000,
+        idleTimeoutMs: 30_000,
+        headers: HEADERS,
+        iptv: policy,
+        ...(signal ? { signal } : {}),
+      },
+    );
+    const root =
+      response.body && typeof response.body === 'object'
+        ? (response.body as Record<string, unknown>)
+        : {};
+    if (!root.episodes || typeof root.episodes !== 'object') throw new Error('bad_response');
+    const bySeason = root.episodes as Record<string, unknown>;
+    const episodes: RawVodEpisode[] = [];
+    for (const [seasonKey, rawList] of Object.entries(bySeason)) {
+      if (!Array.isArray(rawList)) continue;
+      for (const raw of rawList) {
+        if (!raw || typeof raw !== 'object') continue;
+        const item = raw as Record<string, unknown>;
+        const sourceId = stringOf(item.id);
+        if (!/^[A-Za-z0-9_-]{1,40}$/.test(sourceId)) continue;
+        if (episodes.length >= MAX_EPISODES) throw new AppError('iptv_too_large');
+        episodes.push({
+          sourceId,
+          title: (stringOf(item.title) || `Episodio ${episodes.length + 1}`).slice(0, 240),
+          season: numberOf(item.season || seasonKey),
+          episode: numberOf(item.episode_num) || episodes.length + 1,
+          extension: safeVodExtension(item.container_extension),
+        });
+      }
+    }
+    return episodes.sort((a, b) => a.season - b.season || a.episode - b.episode);
+  } catch (error) {
+    throw toIptvError(error, 'list');
+  }
+}
+
+export function xtreamVodUrl(
+  credentials: XtreamCredentials,
+  kind: 'peliculas' | 'episode',
+  sourceId: string,
+  extension: string,
+): string {
+  const segment = (value: string) => encodeURIComponent(value);
+  const path = kind === 'peliculas' ? 'movie' : 'series';
+  return `${credentials.server}/${path}/${segment(credentials.username)}/${segment(credentials.password)}/${segment(sourceId)}.${safeVodExtension(extension)}`;
+}
diff --git a/ace-player-neo/apps/server/src/modules/iptv/vod-catalog.ts b/ace-player-neo/apps/server/src/modules/iptv/vod-catalog.ts
--- /dev/null
+++ b/ace-player-neo/apps/server/src/modules/iptv/vod-catalog.ts
@@ -0,0 +1,248 @@
+import { errorMessage, type IptvVodItem, type IptvVodProgress } from '@ace/shared';
+import { AppError } from '../../core/errors.js';
+import type { IptvFetchPolicy, NetClient } from '../net/types.js';
+import { toIptvError } from './errors.js';
+import { vodLanguage, xtreamVodCategories, xtreamVodItems, type RawVodItem } from './vod.js';
+import type { XtreamCredentials } from './xtream.js';
+
+type Kind = RawVodItem['kind'];
+export interface VodRecord extends IptvVodItem {
+  readonly sourceId: string;
+}
+interface Part {
+  status: IptvVodProgress['status'];
+  categories: Map<string, string>;
+  completed: Set<string>;
+  error: IptvVodProgress['error'];
+  at: number;
+  count: number;
+  retry: string | undefined;
+  priority: string | undefined;
+  controller: AbortController | null;
+}
+const emptyPart = (): Part => ({
+  status: 'idle',
+  categories: new Map(),
+  completed: new Set(),
+  error: null,
+  at: 0,
+  count: 0,
+  retry: undefined,
+  priority: undefined,
+  controller: null,
+});
+export const emptyVodProgress = (): IptvVodProgress => ({
+  status: 'idle',
+  loadedCategories: 0,
+  totalCategories: 0,
+  error: null,
+});
+
+/** A browse request only reads memory. Provider I/O never holds the HTTP response open. */
+export class VodCatalog {
+  readonly byId = new Map<string, VodRecord>();
+  readonly episodes = new Map<string, { sourceId: string; extension: string }>();
+  private readonly parts: Record<Kind, Part> = { peliculas: emptyPart(), series: emptyPart() };
+  private disposed = false;
+
+  constructor(
+    readonly providerId: string,
+    readonly revision: number,
+    private readonly deps: {
+      net: NetClient;
+      credentials: XtreamCredentials;
+      policy: IptvFetchPolicy;
+      now: () => number;
+      id: (key: string) => string;
+      redact: (text: string) => string;
+    },
+  ) {}
+
+  dispose(): void {
+    this.disposed = true;
+    for (const part of Object.values(this.parts)) part.controller?.abort();
+    this.byId.clear();
+    this.episodes.clear();
+  }
+
+  ensure(kind: 'todos' | Kind, category?: string, retry?: string): void {
+    for (const selected of kind === 'todos' ? (['peliculas', 'series'] as const) : [kind]) {
+      const part = this.parts[selected];
+      const prefix = selected === 'peliculas' ? 'm:' : 's:';
+      if (category?.startsWith(prefix)) part.priority = category.slice(2);
+      const requested = retry !== undefined && retry !== part.retry;
+      if (retry !== undefined) part.retry = retry;
+      if (this.disposed || part.controller) continue;
+      if (
+        part.status !== 'idle' &&
+        !requested &&
+        (part.status !== 'ready' || this.deps.now() - part.at < 15 * 60_000)
+      )
+        continue;
+      part.status = 'loading';
+      part.error = null;
+      part.completed.clear();
+      const controller = new AbortController();
+      part.controller = controller;
+      // load handles all provider failures and publishes a sanitized terminal state.
+      void this.load(selected, part, controller);
+    }
+  }
+
+  progress(kind: Kind): IptvVodProgress {
+    const part = this.parts[kind];
+    return {
+      status: part.status,
+      loadedCategories: part.completed.size,
+      totalCategories: part.categories.size,
+      error: part.error,
+    };
+  }
+
+  categories(kind: 'todos' | Kind): { id: string; name: string; count: number; loaded: boolean }[] {
+    const result = new Map<string, { id: string; name: string; count: number; loaded: boolean }>();
+    for (const selected of kind === 'todos' ? (['peliculas', 'series'] as const) : [kind]) {
+      const part = this.parts[selected];
+      for (const [key, name] of part.categories) {
+        const id = `${selected === 'peliculas' ? 'm' : 's'}:${key}`;
+        result.set(id, {
+          id,
+          name: this.deps.redact(name),
+          count: 0,
+          loaded: part.completed.has(key),
+        });
+      }
+    }
+    for (const item of this.byId.values()) {
+      if (kind !== 'todos' && kind !== item.kind) continue;
+      const entry = result.get(item.categoryId);
+      if (entry) entry.count++;
+      else if (item.category)
+        result.set(item.categoryId, {
+          id: item.categoryId,
+          name: item.category,
+          count: 1,
+          loaded: this.parts[item.kind].status === 'ready',
+        });
+    }
+    return [...result.values()];
+  }
+
+  private put(raw: RawVodItem, part: Part, seen: Set<string>): void {
+    if (this.disposed) return;
+    const id = this.deps.id(`vod:${raw.kind}:${raw.sourceId}`);
+    if (!this.byId.has(id) && part.count >= 100_000) throw new AppError('iptv_too_large');
+    const category = this.deps.redact(part.categories.get(raw.categoryId) ?? '');
+    if (!this.byId.has(id)) part.count++;
+    this.byId.set(id, {
+      id,
+      kind: raw.kind,
+      title: this.deps.redact(raw.title),
+      category,
+      categoryId: `${raw.kind === 'peliculas' ? 'm' : 's'}:${raw.categoryId}`,
+      language: vodLanguage(raw.language, category),
+      extension: raw.extension,
+      sourceId: raw.sourceId,
+    });
+    seen.add(id);
+  }
+
+  private async load(kind: Kind, part: Part, controller: AbortController): Promise<void> {
+    const { net, credentials, policy } = this.deps;
+    const { signal } = controller;
+    // Includes the bulk attempt and all category fallbacks; never retry indefinitely.
+    const timer = setTimeout(() => controller.abort(new AppError('iptv_timeout')), 8 * 60_000);
+    timer.unref();
+    const seen = new Set<string>();
+    const onItem = (item: RawVodItem) => this.put(item, part, seen);
+    try {
+      try {
+        part.categories = await xtreamVodCategories(
+          net,
+          credentials,
+          kind === 'peliculas' ? 'get_vod_categories' : 'get_series_categories',
+          policy,
+          signal,
+        );
+      } catch (error) {
+        if (signal.aborted) throw signal.reason;
+        // Some panels omit categories but still serve the complete catalog.
+        const code = toIptvError(error, 'list').code;
+        if (code === 'iptv_auth_failed' || code === 'iptv_busy') throw error;
+      }
+      if (signal.aborted) throw signal.reason;
+      try {
+        await xtreamVodItems(net, credentials, kind, policy, signal, { onItem });
+        // Some panels expose titles only when category_id is supplied.
+        if (!seen.size && part.categories.size) throw new AppError('iptv_bad_list');
+        for (const category of part.categories.keys()) part.completed.add(category);
+      } catch (bulkError) {
+        if (signal.aborted) throw signal.reason;
+        const code = toIptvError(bulkError, 'list').code;
+        if (
+          !part.categories.size ||
+          code === 'iptv_auth_failed' ||
+          code === 'iptv_busy' ||
+          code === 'iptv_too_large'
+        )
+          throw bulkError;
+        // A number of panels fail on an unfiltered, very large list. Their category
+        // endpoints are smaller. Prioritize the category selected while loading.
+        const pending = new Set(part.categories.keys());
+        let firstError: unknown = null;
+        while (pending.size) {
+          if (signal.aborted) throw signal.reason;
+          const categoryId =
+            part.priority && pending.has(part.priority)
+              ? part.priority
+              : (pending.values().next().value as string);
+          pending.delete(categoryId);
+          try {
+            await xtreamVodItems(net, credentials, kind, policy, signal, { categoryId, onItem });
+            part.completed.add(categoryId);
+          } catch (error) {
+            if (signal.aborted) throw signal.reason;
+            const failure = toIptvError(error, 'list');
+            if (['iptv_auth_failed', 'iptv_busy', 'iptv_too_large'].includes(failure.code))
+              throw failure;
+            firstError ??= error;
+            part.error = this.failure(error);
+          }
+        }
+        if (firstError) throw firstError;
+      }
+      if (signal.aborted) throw signal.reason;
+      // Only a complete refresh can remove old titles; a failed refresh preserves them.
+      for (const [id, item] of this.byId)
+        if (item.kind === kind && !seen.has(id)) {
+          this.byId.delete(id);
+          part.count--;
+        }
+      part.status = 'ready';
+      part.error = null;
+    } catch (error) {
+      if (!this.disposed) {
+        part.status = part.count ? 'partial' : 'error';
+        part.error = this.failure(signal.aborted ? signal.reason : error);
+      }
+    } finally {
+      clearTimeout(timer);
+      part.at = this.deps.now();
+      part.controller = null;
+    }
+  }
+
+  private failure(error: unknown): NonNullable<IptvVodProgress['error']> {
+    const safe = toIptvError(error, 'list');
+    return {
+      code: safe.code,
+      message:
+        safe.code === 'iptv_bad_list'
+          ? 'El proveedor devolvió una respuesta que no es un catálogo Xtream válido.'
+          : safe.code === 'iptv_busy'
+            ? 'El proveedor ha limitado las consultas. Espera un momento y vuelve a intentarlo.'
+            : errorMessage(safe.code),
+      detail: safe.detail && /^[a-zA-Z0-9_:.-]{1,60}$/.test(safe.detail) ? safe.detail : null,
+    };
+  }
+}
