+  private loadVod(): VodCatalog {
+    this.ensureLoaded();
+    const record = this.record;
+    const secrets = this.secrets;
+    if (!record?.enabled || secrets?.kind !== 'xtream') throw new AppError('iptv_not_configured');
+    if (this.vodState?.providerId === record.id && this.vodState.revision === record.revision)
+      return this.vodState;
+    this.vodState?.dispose();
+    const keys = this.ensureKeys();
+    this.vodState = new VodCatalog(record.id, record.revision, {
+      net: this.deps.net,
+      credentials: secrets,
+      policy: this.policy(),
+      now: () => this.deps.clock.now(),
+      id: (key) => iptvChannelId(keys, record.id, key),
+      redact: (text) => this.redact(text),
+    });
+    return this.vodState;
+  }
+
+  async vodBrowse(query: IptvVodQuery): Promise<IptvVodBrowseResponse> {
+    this.ensureLoaded();
+    const inactive: IptvVodBrowseResponse = {
+      active: false,
+      loading: false,
+      progress: { peliculas: emptyVodProgress(), series: emptyVodProgress() },
+      provider: this.record?.name ?? '',
+      total: 0,
+      movies: 0,
+      series: 0,
+      items: [],
+      categories: [],
+      languages: [],
+      nextOffset: null,
+    };
+    if (!this.record?.enabled || this.secrets?.kind !== 'xtream') return inactive;
+    const state = this.loadVod();
+    state.ensure(query.kind, query.category, query.retry);
+    const items = [...state.byId.values()];
+    const kindItems =
+      query.kind === 'todos' ? items : items.filter((item) => item.kind === query.kind);
+    const progress = { peliculas: state.progress('peliculas'), series: state.progress('series') };
+    const loading = (
+      query.kind === 'todos' ? Object.values(progress) : [progress[query.kind]]
+    ).some((part) => part.status === 'loading');
+    const languages = new Set<string>();
+    for (const item of kindItems) if (item.language) languages.add(item.language);
+    const fold = (text: string) =>
+      text
+        .normalize('NFD')
+        .replace(/[\u0300-\u036f]/g, '')
+        .toLowerCase();
+    const needle = fold(query.q.trim());
+    const filtered = kindItems.filter(
+      (item) =>
+        (!query.category || item.categoryId === query.category) &&
+        (!query.language ||
+          (query.language === '__sin-especificar__'
+            ? !item.language
+            : item.language === query.language)) &&
+        (!needle || fold(`${item.title} ${item.category} ${item.language ?? ''}`).includes(needle)),
+    );
+    const page = filtered.slice(query.offset, query.offset + query.limit);
+    return {
+      active: true,
+      loading,
+      progress,
+      provider: this.record.name,
+      total: filtered.length,
+      movies: items.filter((item) => item.kind === 'peliculas').length,
+      series: items.filter((item) => item.kind === 'series').length,
+      items: page.map(({ sourceId: _sourceId, ...item }) => item),
+      categories: state.categories(query.kind),
+      languages: [...languages].sort((a, b) => a.localeCompare(b, 'es')),
+      nextOffset: query.offset + page.length < filtered.length ? query.offset + page.length : null,
+    };
+  }
+
+  async vodSeries(
+    id: string,
+    signal?: AbortSignal,
+  ): Promise<{ title: string; episodes: IptvVodEpisode[] }> {
+    const state = this.loadVod();
+    const series = state.byId.get(id.toLowerCase());
+    if (!series || series.kind !== 'series') throw new AppError('iptv_gone');
+    const secrets = this.secrets;
+    if (secrets?.kind !== 'xtream') throw new AppError('iptv_disabled');
+    const raw = await xtreamSeriesEpisodes(
+      this.deps.net,
+      secrets,
+      series.sourceId,
+      this.policy(),
+      signal,
+    );
+    if (this.vodState !== state) throw new AppError('iptv_gone');
+    const episodes = raw.map((episode) => {
+      const episodeId = iptvChannelId(
+        this.ensureKeys(),
+        state.providerId,
+        `vod:episode:${series.sourceId}:${episode.sourceId}`,
+      );
+      state.episodes.set(episodeId, { sourceId: episode.sourceId, extension: episode.extension });
+      return {
+        id: episodeId,
+        title: episode.title,
+        season: episode.season,
+        episode: episode.episode,
+        extension: episode.extension,
+      };
+    });
+    return { title: series.title, episodes };
+  }
+
+  async vodVideo(
+    id: string,
+    reply: FastifyReply,
+    range: string | undefined,
+    signal: AbortSignal,
+  ): Promise<void> {
+    const state = this.loadVod();
+    const secrets = this.secrets;
+    if (secrets?.kind !== 'xtream') throw new AppError('iptv_disabled');
+    const movie = state.byId.get(id.toLowerCase());
+    const episode = state.episodes.get(id.toLowerCase());
+    if ((!movie || movie.kind !== 'peliculas') && !episode) throw new AppError('iptv_gone');
+    const sourceId = episode?.sourceId ?? movie?.sourceId ?? '';
+    const extension = episode?.extension ?? movie?.extension ?? 'mp4';
+    if (extension === 'm3u8') throw new AppError('iptv_unsupported');
+    const url = xtreamVodUrl(secrets, episode ? 'episode' : 'peliculas', sourceId, extension);
+    const headers: Record<string, string> = { 'User-Agent': IPTV_USER_AGENT };
+    const direct = extension === 'mp4' || extension === 'mov' || extension === 'webm';
+    if (direct && range && /^bytes=\d*-\d*$/.test(range)) headers.Range = range;
+    const controller = new AbortController();
+    this.vodStreams.add(controller);
+    const abort = () => controller.abort();
+    signal.addEventListener('abort', abort, { once: true });
+    let opened: Awaited<ReturnType<IptvDeps['net']['openStream']>>;
+    try {
+      opened = await this.deps.net.openStream(url, {
+        idleMs: direct ? 30_000 : 90_000,
+        headers,
+        iptv: this.policy(),
+        signal: controller.signal,
+      });
+    } catch (error) {
+      this.vodStreams.delete(controller);
+      signal.removeEventListener('abort', abort);
+      throw error;
+    }
+    reply.raw.once('close', () => {
+      opened.body.destroy();
+      controller.abort();
+      this.vodStreams.delete(controller);
+      signal.removeEventListener('abort', abort);
+    });
+    if (!direct) {
+      const ffmpeg = spawn(
+        'ffmpeg',
+        [
+          '-hide_banner',
+          '-loglevel',
+          'error',
+          '-i',
+          'pipe:0',
+          '-map',
+          '0:v:0?',
+          '-map',
+          '0:a:0?',
+          '-sn',
+          '-c:v',
+          'copy',
+          '-c:a',
+          'aac',
+          '-f',
+          'mp4',
+          '-movflags',
+          'frag_keyframe+empty_moov+default_base_moof',
+          'pipe:1',
+        ],
+        { stdio: ['pipe', 'pipe', 'pipe'] },
+      );
+      ffmpeg.stderr.resume();
+      ffmpeg.stdin.on('error', () => opened.body.destroy());
+      ffmpeg.on('error', () => opened.body.destroy());
+      opened.body.pipe(ffmpeg.stdin);
+      const close = () => {
+        opened.body.destroy();
+        ffmpeg.kill();
+      };
+      reply.raw.once('close', close);
+      signal.addEventListener('abort', close, { once: true });
+      reply
+        .code(200)
+        .header('content-type', 'video/mp4')
+        .header('cache-control', 'private, no-store');
+      reply.send(ffmpeg.stdout);
+      return;
+    }
+    const mime =
+      extension === 'mp4' || extension === 'mov'
+        ? 'video/mp4'
+        : extension === 'webm'
+          ? 'video/webm'
+          : 'application/octet-stream';
+    reply
+      .code(opened.status)
+      .header('content-type', mime)
+      .header('cache-control', 'private, no-store');
+    for (const name of ['content-length', 'content-range', 'accept-ranges'] as const) {
+      const value = opened.headers[name];
+      if (typeof value === 'string') reply.header(name, value);
+    }
+    reply.send(opened.body);
+  }
