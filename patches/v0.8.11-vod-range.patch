diff --git a/ace-player-neo/apps/server/src/modules/iptv/vod-input-proxy.test.ts b/ace-player-neo/apps/server/src/modules/iptv/vod-input-proxy.test.ts
new file mode 100644
index 0000000..3202a4e
--- /dev/null
+++ b/ace-player-neo/apps/server/src/modules/iptv/vod-input-proxy.test.ts
@@ -0,0 +1,78 @@
+import http from 'node:http';
+import { Readable } from 'node:stream';
+
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import type { NetClient } from '../net/index.js';
+import { createVodInputProxy, type VodInputProxy } from './vod-input-proxy.js';
+
+const payload = Buffer.from('0123456789abcdefghijklmnopqrstuvwxyz');
+const proxies: VodInputProxy[] = [];
+
+afterEach(() => {
+  while (proxies.length) proxies.pop()?.close();
+});
+
+function request(url: string, range: string): Promise<{ status: number; body: string }> {
+  return new Promise((resolve, reject) => {
+    const req = http.get(url, { headers: { Range: range } }, (response) => {
+      const chunks: Buffer[] = [];
+      response.on('data', (chunk: Buffer) => chunks.push(chunk));
+      response.once('end', () =>
+        resolve({ status: response.statusCode ?? 0, body: Buffer.concat(chunks).toString() }),
+      );
+    });
+    req.once('error', reject);
+  });
+}
+
+describe('proxy local de entrada VOD', () => {
+  it('permite que ffmpeg pida varios rangos sin conocer la URL Xtream', async () => {
+    const openStream = vi.fn<NetClient['openStream']>(async (_url, options) => {
+      const range = options.headers?.Range ?? 'bytes=0-';
+      const match = /^bytes=(\d+)-(\d*)$/.exec(range);
+      const start = Number(match?.[1] ?? 0);
+      const end = match?.[2] ? Number(match[2]) : payload.length - 1;
+      const body = payload.subarray(start, end + 1);
+      return {
+        status: 206,
+        headers: {
+          'content-type': 'video/mp4',
+          'content-length': String(body.length),
+          'content-range': `bytes ${start}-${end}/${payload.length}`,
+          'accept-ranges': 'bytes',
+        },
+        contentType: 'video/mp4',
+        body: Readable.from(body),
+        finalUrl: 'https://proveedor.example/pelicula.mp4',
+      };
+    });
+    const controller = new AbortController();
+    const proxy = await createVodInputProxy({
+      net: { openStream } as unknown as NetClient,
+      upstreamUrl: 'https://proveedor.example/usuario/secreto/42.mp4',
+      headers: { 'User-Agent': 'Ace Player Neo' },
+      iptv: { lan: false },
+      signal: controller.signal,
+    });
+    proxies.push(proxy);
+
+    expect(proxy.url).toMatch(/^http:\/\/127\.0\.0\.1:\d+\/input$/);
+    expect(proxy.url).not.toContain('usuario');
+    await expect(request(proxy.url, 'bytes=30-35')).resolves.toEqual({
+      status: 206,
+      body: 'uvwxyz',
+    });
+    await expect(request(proxy.url, 'bytes=0-3')).resolves.toEqual({ status: 206, body: '0123' });
+    expect(openStream).toHaveBeenNthCalledWith(
+      1,
+      'https://proveedor.example/usuario/secreto/42.mp4',
+      expect.objectContaining({ headers: expect.objectContaining({ Range: 'bytes=30-35' }) }),
+    );
+    expect(openStream).toHaveBeenNthCalledWith(
+      2,
+      'https://proveedor.example/usuario/secreto/42.mp4',
+      expect.objectContaining({ headers: expect.objectContaining({ Range: 'bytes=0-3' }) }),
+    );
+  });
+});
diff --git a/ace-player-neo/apps/server/src/modules/iptv/vod-input-proxy.ts b/ace-player-neo/apps/server/src/modules/iptv/vod-input-proxy.ts
new file mode 100644
index 0000000..af425f6
--- /dev/null
+++ b/ace-player-neo/apps/server/src/modules/iptv/vod-input-proxy.ts
@@ -0,0 +1,137 @@
+import { createServer } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import type { Readable } from 'node:stream';
+
+import type { IptvFetchPolicy } from '../net/types.js';
+import type { NetClient } from '../net/index.js';
+
+const RANGE = /^bytes=\d*-\d*(?:,\s*\d*-\d*)*$/;
+const FORWARDED_HEADERS = [
+  'content-type',
+  'content-length',
+  'content-range',
+  'accept-ranges',
+  'etag',
+  'last-modified',
+] as const;
+
+export interface VodInputProxy {
+  readonly url: string;
+  close(): void;
+}
+
+interface VodInputProxyOptions {
+  readonly net: NetClient;
+  readonly upstreamUrl: string;
+  readonly headers: Readonly<Record<string, string>>;
+  readonly iptv: IptvFetchPolicy;
+  readonly signal: AbortSignal;
+  readonly host?: '127.0.0.1' | '::1';
+}
+
+/**
+ * Proxy efímero, accesible solo por loopback, para que ffmpeg pueda pedir
+ * rangos de un VOD sin recibir la URL Xtream ni sus credenciales. Pasar un
+ * MP4 por stdin impide buscar su `moov` cuando está al final del archivo.
+ */
+export async function createVodInputProxy(options: VodInputProxyOptions): Promise<VodInputProxy> {
+  const host = options.host ?? '127.0.0.1';
+  const active = new Set<{ readonly controller: AbortController; body?: Readable }>();
+  let closed = false;
+
+  const server = createServer((request, response) => {
+    void (async () => {
+      if (closed || request.url !== '/input' || !['GET', 'HEAD'].includes(request.method ?? '')) {
+        response.statusCode = 404;
+        response.end();
+        return;
+      }
+
+      const controller = new AbortController();
+      const entry: { controller: AbortController; body?: Readable } = { controller };
+      active.add(entry);
+      const abort = () => controller.abort();
+      options.signal.addEventListener('abort', abort, { once: true });
+
+      const headers: Record<string, string> = { ...options.headers };
+      const range = request.headers.range;
+      if (typeof range === 'string' && range.length <= 200 && RANGE.test(range)) {
+        headers.Range = range;
+      }
+
+      const cleanup = () => {
+        options.signal.removeEventListener('abort', abort);
+        active.delete(entry);
+      };
+
+      try {
+        const opened = await options.net.openStream(options.upstreamUrl, {
+          idleMs: 90_000,
+          headers,
+          iptv: options.iptv,
+          signal: controller.signal,
+        });
+        entry.body = opened.body;
+        response.statusCode = opened.status;
+        for (const name of FORWARDED_HEADERS) {
+          const value = opened.headers[name];
+          if (typeof value === 'string' || Array.isArray(value)) response.setHeader(name, value);
+        }
+        response.setHeader('cache-control', 'private, no-store');
+
+        if (request.method === 'HEAD') {
+          opened.body.destroy();
+          response.end();
+          cleanup();
+          return;
+        }
+
+        response.once('close', () => {
+          opened.body.destroy();
+          controller.abort();
+          cleanup();
+        });
+        opened.body.once('error', () => response.destroy());
+        opened.body.once('end', cleanup);
+        opened.body.pipe(response);
+      } catch {
+        cleanup();
+        if (!response.headersSent) response.statusCode = 502;
+        response.end();
+      }
+    })();
+  });
+
+  server.on('clientError', (_error, socket) => socket.destroy());
+  await new Promise<void>((resolve, reject) => {
+    const onError = (error: Error) => reject(error);
+    server.once('error', onError);
+    server.listen(0, host, () => {
+      server.off('error', onError);
+      resolve();
+    });
+  });
+  server.unref();
+
+  const address = server.address() as AddressInfo | null;
+  if (!address) {
+    server.close();
+    throw new Error('vod_input_proxy_not_listening');
+  }
+  const displayHost = address.family === 'IPv6' ? `[${address.address}]` : address.address;
+
+  const close = () => {
+    if (closed) return;
+    closed = true;
+    for (const entry of active) {
+      entry.body?.destroy();
+      entry.controller.abort();
+    }
+    active.clear();
+    server.close();
+    server.closeAllConnections?.();
+  };
+  options.signal.addEventListener('abort', close, { once: true });
+
+  return { url: `http://${displayHost}:${address.port}/input`, close };
+}
