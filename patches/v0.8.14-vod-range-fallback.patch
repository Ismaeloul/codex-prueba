+        let opened: Awaited<ReturnType<NetClient['openStream']>>;
+        try {
+          opened = await options.net.openStream(options.upstreamUrl, {
+            idleMs: 90_000,
+            headers,
+            iptv: options.iptv,
+            signal: controller.signal,
+          });
+        } catch (error) {
+          /* Algunos paneles Xtream responden 500 a `Range: bytes=0-`, que es
