+          if (headers.Range !== 'bytes=0-' || errorCodeOf(error) !== 'http_500') throw error;
+          const retryHeaders = { ...headers };
+          delete retryHeaders.Range;
+          opened = await options.net.openStream(options.upstreamUrl, {
+            idleMs: 90_000,
+            headers: retryHeaders,
+            iptv: options.iptv,
+            signal: controller.signal,
+          });
+        }
         entry.body = opened.body;
