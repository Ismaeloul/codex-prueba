+import { ViewHeader } from '../../app/ViewHeader.tsx';
+import { Button, Card, EmptyState, Icon, Segmented, SkeletonRows, TextField } from '../../ui/index.ts';
+
+type Kind = 'todos' | 'peliculas' | 'series';
+type Playing = { id: string; title: string; extension: string | null };
+
+const plural = (count: number) => `${count} ${count === 1 ? 'título' : 'títulos'}`;
+
+export function XtreamVodView({ active, onShowAce }: { active: boolean; onShowAce: () => void }) {
+  const [query, setQuery] = useSearchParam('psq');
+  const [kindParam, setKindParam] = useSearchParam('pskind');
+  const [language, setLanguage] = useSearchParam('pslang');
+  const [category, setCategory] = useSearchParam('pscat');
+  const [offset, setOffset] = useState(0);
+  const [seriesId, setSeriesId] = useState<string | null>(null);
+  const [playing, setPlaying] = useState<Playing | null>(null);
+  const [playError, setPlayError] = useState(false);
+  const kind: Kind = kindParam === 'peliculas' || kindParam === 'series' ? kindParam : 'todos';
+  const vod = useApiQuery('iptvVodBrowse', {
+    query: {
+      kind, q: query ?? '', offset, limit: 60,
+      ...(category ? { category } : {}),
+      ...(language ? { language } : {}),
+    },
+  }, { enabled: active });
+  const detail = useApiQuery('iptvVodSeries', { params: { id: seriesId ?? '0'.repeat(40) } }, {
+    enabled: active && Boolean(seriesId),
+  });
+  const data = vod.data;
+  const resetPage = () => { setOffset(0); setSeriesId(null); };
+  const selectKind = (next: Kind) => { setKindParam(next === 'todos' ? null : next); setCategory(null); resetPage(); };
+  const selectCategory = (next: string) => { setCategory(next || null); resetPage(); };
+  const selectLanguage = (next: string) => { setLanguage(next || null); resetPage(); };
+  const openVideo = (video: Playing) => { setPlayError(false); setPlaying(video); };
+
+  if (playing) return (
+    <section className="vod">
+      <ViewHeader title={playing.title} subtitle="Reproduciendo desde tu IPTV" />
+      <Button icon="chev-l" onClick={() => { setPlaying(null); setPlayError(false); }}>Volver a Pelis y Series</Button>
+      <video
+        key={playing.id}
+        className="vod__video"
+        controls
+        playsInline
+        preload="metadata"
+        src={routeUrl('iptvVodVideo', { id: playing.id })}
+        onError={() => setPlayError(true)}
+      >Tu navegador no puede reproducir este vídeo.</video>
+      {playError ? <p role="alert" className="vod__play-error">No se pudo reproducir este archivo. El proveedor puede haberlo retirado o el formato puede no ser compatible con este navegador.</p> : null}
+    </section>
+  );
+
+  if (seriesId) return (
+    <section className="vod">
+      <ViewHeader title={detail.data?.title ?? 'Serie'} subtitle="Temporadas y episodios de tu IPTV" />
+      <Button icon="chev-l" onClick={() => setSeriesId(null)}>Volver al catálogo</Button>
+      {detail.isLoading ? <SkeletonRows rows={5} label="Cargando episodios…" /> : null}
+      {detail.isError ? <EmptyState title="No se pudieron cargar los episodios" tone="error" actions={<Button icon="refresh" onClick={() => void detail.refetch()}>Reintentar</Button>}>Comprueba la conexión con tu IPTV.</EmptyState> : null}
+      {detail.data && detail.data.episodes.length === 0 ? <EmptyState title="Esta serie no tiene episodios publicados" actions={null}>El proveedor aún no ofrece episodios para esta serie.</EmptyState> : null}
+      {detail.data?.episodes.map((episode) => (
+        <Card as="article" key={episode.id} className="vod__episode">
+          <div>
+            <strong>Temporada {episode.season} · Episodio {episode.episode}</strong>
+            <p>{episode.title}</p>
+          </div>
+          <Button icon="play" onClick={() => openVideo({ id: episode.id, title: episode.title, extension: episode.extension })}>Reproducir</Button>
+        </Card>
+      ))}
+    </section>
+  );
+
+  return (
+    <section className="vod">
+      <ViewHeader title="Pelis y Series" subtitle={data?.active ? `${data.provider} · ${plural(data.movies + data.series)}` : 'Catálogo de películas y series de tu IPTV'} />
+      <Button icon="cine" onClick={onShowAce}>Ver entradas AceStream</Button>
+      <div className="vod__toolbar">
+        <Segmented<Kind> label="Filtrar por tipo" block value={kind} onChange={selectKind} items={[
+          { value: 'todos', label: 'Todo', count: data ? data.movies + data.series : undefined },
+          { value: 'peliculas', label: 'Películas', count: data?.movies },
+          { value: 'series', label: 'Series', count: data?.series },
+        ]} />
+        <div className="vod__filters">
+          <TextField aria-label="Buscar películas y series" label="Buscar películas y series" hideLabel variant="search" type="search" icon="buscar" placeholder="Buscar por título, categoría o idioma" value={query ?? ''} onChange={(event) => { setQuery(event.currentTarget.value || null); resetPage(); }} autoComplete="off" spellCheck={false} />
+          <label className="vod__language"><span>Idioma</span>
+            <select value={language ?? ''} onChange={(event) => selectLanguage(event.currentTarget.value)}>
+              <option value="">Todos los idiomas</option>
+              {data?.languages.map((item) => <option key={item} value={item}>{item}</option>)}
+              <option value="__sin-especificar__">Sin especificar</option>
+            </select><Icon name="chev-d" size={18} />
+          </label>
+          <label className="vod__language"><span>Categoría</span>
+            <select value={category ?? ''} onChange={(event) => selectCategory(event.currentTarget.value)}>
+              <option value="">Todas las categorías</option>
+              {data?.categories.map((item) => <option key={item.id} value={item.id}>{item.name} ({item.count})</option>)}
+            </select><Icon name="chev-d" size={18} />
+          </label>
+        </div>
+      </div>
+      {vod.isLoading ? <SkeletonRows rows={6} label="Cargando catálogo de tu IPTV…" /> : null}
+      {vod.isError ? <EmptyState title="No se pudo cargar el catálogo de tu IPTV" tone="error" actions={<Button icon="refresh" onClick={() => void vod.refetch()}>Reintentar</Button>}>Comprueba que tu cuenta Xtream esté activa.</EmptyState> : null}
+      {data?.active ? <p className="vod__count" aria-live="polite">{plural(data.total)} encontrados · Página {Math.floor(offset / 60) + 1}</p> : null}
+      {data?.active && data.items.length ? <div className="vod__grid" aria-label="Películas y series de tu IPTV">
+        {data.items.map((item: IptvVodItem) => <Card as="article" key={item.id} padding={0} className="vod-card">
+          <div className={`vod-card__art ${item.kind === 'series' ? 'vod-card__art--series' : ''}`} aria-hidden="true">
+            <span className="vod-card__type">{item.kind === 'series' ? 'SERIE' : 'PELÍCULA'}</span>
+            <Icon name="cine" size={32} />
+            <span className="vod-card__initial">{item.title.slice(0, 1).toLocaleUpperCase('es')}</span>
+          </div>
+          <div className="vod-card__body">
+            <h2 title={item.title}>{item.title}</h2>
+            {item.category ? <p className="vod-card__category" title={item.category}>{item.category}</p> : null}
+            <p className="vod-card__language"><Icon name="learn" size={16} />{item.language ?? 'Idioma sin especificar'}</p>
+            <Button variant="primary" icon={item.kind === 'series' ? 'list' : 'play'} block onClick={() => item.kind === 'series' ? setSeriesId(item.id) : openVideo({ id: item.id, title: item.title, extension: item.extension })}>
+              {item.kind === 'series' ? 'Ver episodios' : 'Reproducir'}
+            </Button>
+          </div>
+        </Card>)}
+      </div> : null}
+      {data?.active && data.total === 0 ? <EmptyState title="No hay resultados" actions={null}>Prueba con otro título, categoría o idioma.</EmptyState> : null}
+      {data?.active && data.total > 0 ? <div className="vod__pages">
+        <Button disabled={offset === 0} onClick={() => setOffset(Math.max(0, offset - 60))}>Anterior</Button>
+        <Button disabled={data.nextOffset === null} onClick={() => setOffset(data.nextOffset ?? offset)}>Siguiente</Button>
+      </div> : null}
+    </section>
+  );
+}
