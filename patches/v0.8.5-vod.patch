+  async vodBrowse(query: IptvVodQuery): Promise<IptvVodBrowseResponse> {
+    this.ensureLoaded();
+    const inactive: IptvVodBrowseResponse = {
+      active: false, provider: this.record?.name ?? '', total: 0, movies: 0, series: 0,
+      items: [], categories: [], languages: [], nextOffset: null,
+    };
+    if (!this.record?.enabled || this.secrets?.kind !== 'xtream') return inactive;
+    const state = await this.loadVod();
+    const kindItems = query.kind === 'todos' ? state.items : state.items.filter((item) => item.kind === query.kind);
+    const categories = new Map<string, { id: string; name: string; count: number }>();
+    const languages = new Set<string>();
+    for (const item of kindItems) {
+      if (item.categoryId && item.category) {
+        const entry = categories.get(item.categoryId);
+        if (entry) entry.count += 1;
+        else categories.set(item.categoryId, { id: item.categoryId, name: item.category, count: 1 });
+      }
+      if (item.language) languages.add(item.language);
+    }
+    const fold = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
+    const needle = fold(query.q.trim());
+    const filtered = kindItems.filter((item) =>
+      (!query.category || item.categoryId === query.category) &&
+      (!query.language || (query.language === '__sin-especificar__' ? !item.language : item.language === query.language)) &&
+      (!needle || fold(`${item.title} ${item.category} ${item.language ?? ''}`).includes(needle)));
+    const page = filtered.slice(query.offset, query.offset + query.limit);
+    return {
+      active: true, provider: this.record.name, total: filtered.length,
+      movies: state.items.filter((item) => item.kind === 'peliculas').length,
+      series: state.items.filter((item) => item.kind === 'series').length,
+      items: page.map(({ sourceId: _sourceId, sourceLanguage: _sourceLanguage, ...item }) => item),
+      categories: [...categories.values()],
+      languages: [...languages].sort((a, b) => a.localeCompare(b, 'es')),
+      nextOffset: query.offset + page.length < filtered.length ? query.offset + page.length : null,
+    };
+  }
+
+  async vodSeries(id: string): Promise<{ title: string; episodes: IptvVodEpisode[] }> {
+    const state = await this.loadVod();
+    const series = state.byId.get(id.toLowerCase());
+    if (!series || series.kind !== 'series') throw new AppError('iptv_gone');
+    const secrets = this.secrets;
+    if (secrets?.kind !== 'xtream') throw new AppError('iptv_disabled');
+    const raw = await xtreamSeriesEpisodes(this.deps.net, secrets, series.sourceId, this.policy());
+    if (this.vodState !== state) throw new AppError('iptv_gone');
+    const episodes = raw.map((episode) => {
+      const episodeId = iptvChannelId(this.ensureKeys(), state.providerId, `vod:episode:${series.sourceId}:${episode.sourceId}`);
+      state.episodes.set(episodeId, { sourceId: episode.sourceId, extension: episode.extension });
+      return { id: episodeId, title: episode.title, season: episode.season, episode: episode.episode, extension: episode.extension };
+    });
+    return { title: series.title, episodes };
+  }
