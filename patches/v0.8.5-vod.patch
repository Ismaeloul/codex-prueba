+  private async loadVod(): Promise<VodState> {
+    this.ensureLoaded();
+    const record = this.record;
+    const secrets = this.secrets;
+    if (!record?.enabled || secrets?.kind !== 'xtream') throw new AppError('iptv_not_configured');
+    const current = this.vodState;
+    if (current?.providerId === record.id && current.revision === record.revision &&
+      this.deps.clock.now() - current.at < 15 * MINUTE) return current;
+    if (this.vodLoading) return this.vodLoading;
+    const load = async (): Promise<VodState> => {
+      const credentials = secrets;
+      const policy = this.policy();
+      const movieCategories = await xtreamVodCategories(this.deps.net, credentials, 'get_vod_categories', policy)
+        .catch(() => new Map<string, string>());
+      const seriesCategories = await xtreamVodCategories(this.deps.net, credentials, 'get_series_categories', policy)
+        .catch(() => new Map<string, string>());
+      const moviesResult = await xtreamVodItems(this.deps.net, credentials, 'peliculas', policy)
+        .then((items) => ({ items, error: null as unknown })).catch((error: unknown) => ({ items: [] as RawVodItem[], error }));
+      const seriesResult = await xtreamVodItems(this.deps.net, credentials, 'series', policy)
+        .then((items) => ({ items, error: null as unknown })).catch((error: unknown) => ({ items: [] as RawVodItem[], error }));
+      if (moviesResult.error && seriesResult.error) throw moviesResult.error;
+      const movies = moviesResult.items;
+      const series = seriesResult.items;
+      if (this.record?.id !== record.id || this.record.revision !== record.revision || !this.record.enabled)
+        throw new AppError('iptv_gone');
+      const keys = this.ensureKeys();
+      const byId = new Map<string, VodRecord>();
+      const make = (raw: RawVodItem): VodRecord => {
+        const categoryName = (raw.kind === 'peliculas' ? movieCategories : seriesCategories).get(raw.categoryId) ?? '';
+        const categoryId = `${raw.kind === 'peliculas' ? 'm' : 's'}:${raw.categoryId}`;
+        const item: VodRecord = {
+          id: iptvChannelId(keys, record.id, `vod:${raw.kind}:${raw.sourceId}`),
+          kind: raw.kind,
+          title: raw.title,
+          category: categoryName,
+          categoryId,
+          language: vodLanguage(raw.language, categoryName),
+          extension: raw.extension,
+          sourceId: raw.sourceId,
+          sourceLanguage: raw.language,
+        };
+        byId.set(item.id, item);
+        return item;
+      };
+      const state: VodState = {
+        providerId: record.id,
+        revision: record.revision,
+        at: this.deps.clock.now(),
+        items: [...movies.map(make), ...series.map(make)],
+        byId,
+        episodes: current?.providerId === record.id && current.revision === record.revision
+          ? new Map(current.episodes) : new Map(),
+      };
+      this.vodState = state;
+      return state;
+    };
+    this.vodLoading = load();
+    try { return await this.vodLoading; }
+    finally { this.vodLoading = null; }
+  }
