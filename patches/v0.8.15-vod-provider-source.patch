+function safePlaybackUrl(value: unknown, base: string): string | null {
+  const text = stringOf(value);
+  // eslint-disable-next-line no-control-regex
+  if (!text || text.length > 4096 || /[\u0000-\u001f\u007f]/.test(text)) return null;
+  try {
+    const url = new URL(text, base);
+    if ((url.protocol !== 'http:' && url.protocol !== 'https:') || url.username || url.password)
+      return null;
+    url.hash = '';
+    return url.toString();
+  } catch {
+    return null;
+  }
+}
+
+export function vodPlayback(
+  value: unknown,
+  fallbackId: string,
+  fallbackExtension: string,
+  base: string,
+): RawVodPlayback {
+  const item = value && typeof value === 'object' ? (value as Record<string, unknown>) : {};
+  const declaredId = stringOf(item.stream_id ?? item.id);
+  return {
+    sourceId: /^[A-Za-z0-9_-]{1,40}$/.test(declaredId) ? declaredId : fallbackId,
+    extension: vodExtension(item.container_extension, item.name ?? item.title ?? fallbackExtension),
+    directUrl: safePlaybackUrl(item.direct_source, base),
+  };
+}
